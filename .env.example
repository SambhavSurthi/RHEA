APP_ENV=development
LOG_LEVEL=INFO
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rhea_papers

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rhea-demo
NEO4J_DATABASE=neo4j

EMBEDDING_DIM=384
TOP_K_VECTOR=8
TOP_K_GRAPH=8
RRF_K=60
GRAPH_MAX_HOPS=3
ALLOW_IN_MEMORY_FALLBACK=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=rhea

# RBAC: comma-separated API keys per role. Leave unset in development to
# use the demo defaults below; ALWAYS set unique, secret values before any
# non-local deployment. An admin key also satisfies writer/reader checks.
API_KEYS_READER=demo-reader-key
API_KEYS_WRITER=demo-writer-key
API_KEYS_ADMIN=demo-admin-key

# Canonical document/chunk storage (Phase 1)
# Local development defaults are documented in docs/plans/RHEA-001-phase-1-canonical-architecture.md.
# Replace these with managed secrets for any non-local deployment.
RHEA_POSTGRES_DSN=postgresql+psycopg://rhea:rhea-demo@localhost:5432/rhea
RHEA_POSTGRES_HOST_PORT=5432
RHEA_POSTGRES_POOL_SIZE=5
RHEA_POSTGRES_STATEMENT_TIMEOUT=30
RHEA_OBJECT_STORE_BACKEND=filesystem
RHEA_OBJECT_STORE_PATH=./storage/objects
POSTGRES_DB=rhea
POSTGRES_USER=rhea
POSTGRES_PASSWORD=rhea-demo

# Content safety
BLOCK_QUARANTINED_INGEST=false
EXCLUDE_QUARANTINED_FROM_CONTEXT=true
